{
  "name": "server",
  "version": "2.4.3",
  "private": true,
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf ../../build/server",
    "start": "tsx watch src/main/server.ts",
    "build": "webpack --config webpack/webpack.config.cjs",
    "lint": "eslint -c .eslintrc.cjs \"**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "type": "module",
  "engines": {
    "node": ">=24.7.0",
    "npm": ">=11.5.1"
  },
  "overrides": {
    "semver": "7.7.3",
    "word-wrap": "1.2.5",
    "tough-cookie": "6.0.0",
    "postcss": "8.5.6",
    "qs": "6.14.1",
    "crypto-js": "4.2.0"
  },
  "dependencies": {
    "audit-debounce": "0.1.1",
    "body-parser": "1.20.4",
    "canvas": "3.2.1",
    "cors": "2.8.6",
    "express": "4.22.1",
    "fast-json-patch": "3.1.1",
    "global-jsdom": "27.0.0",
    "jsdom": "27.4.0",
    "ms": "2.1.3",
    "pdfmake": "0.3.3",
    "redis": "4.7.1",
    "rxjs": "7.8.2",
    "shared": "*"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/ms": "2.1.0",
    "@types/node": "24.10.9",
    "@types/pdfmake": "0.2.12",
    "copy-webpack-plugin": "13.0.1",
    "tsx": "4.21.0",
    "vitest": "4.0.18"
  }
}
